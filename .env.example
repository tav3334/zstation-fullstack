# ── Base de données Supabase (Project Settings → Database → Connection string) ──
# Connexion poolée (Transaction pooler, port 6543) : utilisée par l'API en serverless
TONSOR_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe (Session pooler, port 5432) : utilisée par Prisma pour les migrations
TONSOR_DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── URL publique du frontend (retour Stripe). Optionnel : déduit de la requête si absent ──
FRONTEND_URL="http://localhost:5173"

# ── Stripe ──
STRIPE_SECRET=""
STRIPE_WEBHOOK_SECRET=""

# ── Notifications WhatsApp (Green API) — optionnel ──
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""
GREEN_API_CHAT_ID=""

# ── Migration des données depuis l'ancien MySQL (script migrate:mysql) ──
MYSQL_URL="mysql://root:@127.0.0.1:3306/zstation"

# ── Seed d'une base vide (script db:seed) ──
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="change-me-please"
